# MiniMax API Configuration
# 用于与 MiniMax 大模型交互进行 AI 答疑

# MiniMax API Key - 从 https://www.minimax.io/ 或中国站获取
MINIMAX_API_KEY=your_minimax_api_key_here

# MiniMax Model Type (可选，默认使用 MiniMax M2.7)
MINIMAX_MODEL_TYPE=MiniMax M2.7

# MiniMax API Base URL
# 中国服务: https://api.minimaxi.com/v1
# 国际服务: https://api.minimaxi.com/v1
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
